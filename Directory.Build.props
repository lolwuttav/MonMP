<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.9.110</Version>
    <MonMPDevelopmentTools Condition="'$(MonMPDevelopmentTools)' == '' and '$(Configuration)' == 'Debug'">true</MonMPDevelopmentTools>
    <MonMPDevelopmentTools Condition="'$(MonMPDevelopmentTools)' == ''">false</MonMPDevelopmentTools>
    <MonMPPerformanceCapture Condition="'$(MonMPPerformanceCapture)' == ''">false</MonMPPerformanceCapture>
    <MonMPLocalTestIsolation Condition="'$(MonMPLocalTestIsolation)' == ''">false</MonMPLocalTestIsolation>
    <DefineConstants Condition="'$(MonMPLocalTestIsolation)' == 'true'">$(DefineConstants);MONMP_LOCAL_TEST_ISOLATION</DefineConstants>
    <MonMPPerformanceOutput Condition="'$(MonMPLocalTestIsolation)' != 'true'">performance-capture</MonMPPerformanceOutput>
    <MonMPPerformanceOutput Condition="'$(MonMPLocalTestIsolation)' == 'true'">local-test-performance-capture</MonMPPerformanceOutput>
    <DefineConstants Condition="'$(MonMPPerformanceCapture)' == 'true'">$(DefineConstants);MONMP_PERFORMANCE_CAPTURE</DefineConstants>
    <BaseOutputPath Condition="'$(MonMPPerformanceCapture)' == 'true'">$(MSBuildThisFileDirectory).artifacts/$(MonMPPerformanceOutput)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(MonMPPerformanceCapture)' == 'true'">$(MSBuildThisFileDirectory).artifacts/$(MonMPPerformanceOutput)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <DefaultItemExcludes Condition="'$(MonMPPerformanceCapture)' == 'true'">$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <DefineConstants Condition="'$(MonMPDevelopmentTools)' == 'true' or $([System.String]::Copy('$(MSBuildProjectName)').Contains('Test'))">$(DefineConstants);MONMP_DEVELOPMENT</DefineConstants>
    <DefineConstants Condition="'$(MonMPDevelopmentTools)' == 'true'">$(DefineConstants);MONMP_CORE_TESTING</DefineConstants>
    <GameDirectory Condition="'$(GameDirectory)' == ''">$(MSBuildThisFileDirectory)MonBazou</GameDirectory>
    <GameManaged>$(GameDirectory)/Mon Bazou_Data/Managed</GameManaged>
    <BepInExDirectory Condition="'$(BepInExDirectory)' == ''">$(MSBuildThisFileDirectory).deps/BepInEx-5.4.23.5/BepInEx/core</BepInExDirectory>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MonMP.DevelopmentTools</_Parameter1>
      <_Parameter2>$(MonMPDevelopmentTools)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MonMP.PerformanceCapture</_Parameter1>
      <_Parameter2>$(MonMPPerformanceCapture)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MonMP.LocalTestIsolation</_Parameter1>
      <_Parameter2>$(MonMPLocalTestIsolation)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="CheckPerformanceCaptureConfiguration" BeforeTargets="PrepareForBuild" Condition="'$(MonMPPerformanceCapture)' == 'true'">
    <Error Condition="'$(MonMPDevelopmentTools)' == 'true'" Text="Performance capture requires MonMPDevelopmentTools=false. It is a separate capture build without developer/gameplay tools." />
  </Target>
  <Target Name="CheckLocalTestIsolationConfiguration" BeforeTargets="PrepareForBuild" Condition="'$(MonMPLocalTestIsolation)' == 'true'">
    <Error Condition="'$(MonMPPerformanceCapture)' != 'true' or '$(MonMPDevelopmentTools)' == 'true'" Text="Local-test capture isolation requires MonMPPerformanceCapture=true and MonMPDevelopmentTools=false. Use the ordinary Development variant for automated fixtures." />
  </Target>
</Project>
